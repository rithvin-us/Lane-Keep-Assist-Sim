# ==============================================================================
# MATLAB and Simulink Git Ignore Rules
# Designed for Automotive / SAE Competition Projects (MAAB Compliant)
# ==============================================================================

# MATLAB autosave and backup files
*.asv
*.autosave
*.m~
*.slx~
*.mdl~
*.tmp
*.bak

# Simulink cache, code generation, and build artifacts
work/
slprj/
*.slxc
*.mex*
*.mexw64
*.mexmaci64
*.mexa64

# Project desktop, user preferences, and cache
.SimulinkProject/
*.prj.user
*.matlab/
matlab.log
*.vbl
*.tfl

# Large simulation output logs and diagnostic runs
simulation_results/
simulation_logs/
*.csv.tmp
*.mat.tmp

# OS generated files
.DS_Store
Thumbs.db
[Dd]esktop.ini

# LKA MIL run artefacts (figures and KPI csv are kept)
results/**/*.mat

# 2025 Python ADAS stack: separate repo (RatheeswarS/ADAS_2026), read-only reference
ADAS_2026/
# Lane detectors (perception/<Approach>/): Python venv, upstream clone metadata, and the
# networks MATLAB imports from the .onnx (regenerated by lka_import_onnx_detector)
perception/*/.venv/
perception/.*_upstream.git/
perception/**/*_dlnetwork.mat
perception/**/+lka_onnx_*/
# Archived detectors: imported networks, the read-only LaneAssist reference checkout,
# the > 100 MB team CNN (team Drive)
backup_lane_detection/**/*_dlnetwork.mat
backup_lane_detection/**/+lka_onnx_*/
backup_lane_detection/reference/
backup_lane_detection/models/perception/team_cnn.onnx
# Camera datasets, videos, ONNX parity fixtures
data/vision_datasets/
results/**/*.mp4
tests/fixtures/*.bin
# Written by Unreal next to the scene on every run
data/scenes/LKA/sim3dSemanticTypes.xml

# Live dashboard telemetry (lka_monitor_publish)
results/monitor/

# Python bytecode
__pycache__/
*.pyc

# Local check reports and their video results (run_lka_checks)
results/checks/

# Annotated clips (20-50 MB each, reproducible with run_lka_on_video). The older
# lka_video_annotated.mp4 files already in git stay tracked.
test_res/**/*.mp4
backup_lane_detection/test_res/**/lka_annotated_*.mp4
backup_lane_detection/test_res/**/college_lane*/*.mp4
# Live camera sessions: the per-frame CSVs and the overview are kept, raw recordings not
results/live/**/*.mp4
