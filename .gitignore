# ==============================================================================
# MATLAB and Simulink Git Ignore Rules
# Designed for Automotive / SAE Competition Projects (MAAB Compliant)
# ==============================================================================

# MATLAB autosave and backup files
*.asv
*.autosave
*.m~
*.slx~
*.mdl~
*.tmp
*.bak

# Simulink cache, code generation, and build artifacts
work/
slprj/
*.slxc
*.mex*
*.mexw64
*.mexmaci64
*.mexa64

# Project desktop, user preferences, and cache
.SimulinkProject/
*.prj.user
*.matlab/
matlab.log
*.vbl
*.tfl

# Large simulation output logs and diagnostic runs
simulation_results/
simulation_logs/
*.csv.tmp
*.mat.tmp

# OS generated files
.DS_Store
Thumbs.db
[Dd]esktop.ini

# LKA MIL run artefacts (figures and KPI csv are kept)
results/**/*.mat

# 2025 Python ADAS stack: separate repo (RatheeswarS/ADAS_2026), read-only reference
ADAS_2026/
# Team CNN (UFLDv2) ONNX is > 100 MB: shared through Drive, see models/perception/README.md
models/perception/team_cnn.onnx
# Imported ONNX networks (regenerated from the .onnx by lka_import_onnx_detector)
models/perception/*_dlnetwork.mat
models/perception/+lka_onnx_*/
# Camera datasets, videos, ONNX parity fixtures
data/vision_datasets/
results/**/*.mp4
tests/fixtures/*.bin
# Written by Unreal next to the scene on every run
data/scenes/LKA/sim3dSemanticTypes.xml

# Live dashboard telemetry (lka_monitor_publish)
results/monitor/

# Python bytecode
__pycache__/
*.pyc

# LaneAssist (tsiggi, MIT): read-only reference for the detector comparison, see
# docs/laneassist_comparison.md
LaneAssist/

# Annotated clips rendered by the ffmpeg path (51 MB); the frames are reproducible,
# see requirements/system.md. The older lka_video_annotated.mp4 files stay tracked.
test_res/**/lka_annotated_*.mp4
